# Copy to leaderboard/.env (git-ignored) and paste your Tiger Cloud connection string.
# Tiger Cloud console -> your service -> Connect -> "Connection string". Keep ?sslmode=require.
LEADERBOARD_DATABASE_URL=postgres://tsdbadmin:YOUR_PASSWORD@YOUR_SERVICE.tsdb.cloud.timescale.com:YOUR_PORT/tsdb?sslmode=require
# Optional:
# LEADERBOARD_PORT=8768
# LEADERBOARD_HOST=127.0.0.1
